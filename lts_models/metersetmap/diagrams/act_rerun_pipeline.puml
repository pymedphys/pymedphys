@startuml act_rerun_pipeline
' SysML Activity Diagram
' Per-rerun execution flow for metersetmap. The script runs main() top-to-
' bottom on every rerun, walking through 5 ordered phases:
'   1. Sidebar render (config, overview placeholders, status, advanced toggle)
'   2. Sidebar event dispatch (status_check, compare_baseline)
'   3. Main page widget render (data selection, output config, run button)
'   4. Main page event dispatch (input methods, output config, run calculation)
'   5. Conditional compute pipeline (only if click(run_calculation_button))
' The compute pipeline detail is in act_compute_pipeline.svg.

title <<act>> metersetmap -- Per-Rerun Execution Pipeline

skinparam activityBackgroundColor #f9fbe7
skinparam activityBorderColor #827717
skinparam activityFontColor #827717
skinparam activityDiamondBackgroundColor #fff3e0
skinparam activityDiamondBorderColor #e65100
skinparam shadowing false
skinparam Padding 4

|Phase 1: Sidebar render (streamlit_boundary)|
start
:st.sidebar.markdown("# Configuration Choice");
:st.sidebar.radio("Config Mode", config_options);
note right
    PY:591 -- always returns one of `options`;
    on first render auto-selects the first.
end note
:st.sidebar.markdown("# MetersetMap Overview");
:st.sidebar.empty (Reference + Evaluation placeholders);
note right
    PY:594-619 -- two placeholders created via
    st.sidebar.empty(); populated later in this rerun
    once the input methods return their results.
end note
:st.sidebar.markdown("# Status indicators");
:st.sidebar.markdown("# Advanced options");
:st.sidebar.checkbox("Run in Advanced Mode");
note right
    PY:636 -- gates several downstream widgets.
end note

|Phase 2: Sidebar event dispatch|
if (status_check_button == True?) then (yes)
    :compute_ops:run_status_check_pipeline;
    note right
        PY:101-138 -- per-linac iCOM + TRF backup scan,
        accumulates sidebar status lines.
        OR error_config_missing on KeyError.
    end note
endif
if (compare_baseline_button == True\nAND advanced_mode?) then (yes)
    :compute_ops:run_advanced_debugging_pipeline;
    note right
        PY:373-434
    end note
endif

|Phase 3: Main page widget render (Selection of data)|
:st.write("## Selection of data to compare");
:st.columns(2) -- ref + eval columns;
note right
    PY:669
end note
fork
    :Reference column;
    :get_input_data_ui("reference");
    note right
        PY:678-684
        if advanced_mode:
          st.selectbox("Data Input Method")
        else:
          method = config_default
        Then dispatches to one of:
          monaco_input_method
          dicom_input_method
          icom_input_method
          trf_input_method
          mosaiq_input_method
        Sub-LTS [DEFERRED in orchestration-first build]
    end note
fork again
    :Evaluation column;
    :get_input_data_ui("evaluation",\n  **previous_results=reference_results);
    note right
        PY:693-700
        Same shape; sees reference_results so site/patient_id
        defaults are pre-filled.
    end note
end fork

|Phase 4: Main page output config + Run button|
:st.write("---");
:st.write("## Output Locations");
:st_misc.get_site_and_directory("eScan Site", default=site);
note right
    PY:722-728 -- escan_site_selected event source
end note
if (advanced_mode?) then (yes)
    :st.text_input("png output directory", default);
    note right
        PY:746-748 -- png_output_directory_changed event source
    end note
else (no)
    :png_output_directory := config_default;
endif
:st.write("## Calculation");
:st.button("Run Calculation");
note right
    PY:764 -- click(run_calculation_button) event source
end note

|Phase 5: Conditional compute pipeline|
if (run_calculation_button == True?) then (yes)
    if (can_run_calculation\n  (both_results_present\n   AND escan_directory_chosen)?) then (yes)
        :widget_ops:run_calculation_clicked\n  -> tier := modal_warning_metersetmap_usage;
        :compute_ops:run_calculation_pipeline;
        note right
            See act_compute_pipeline.svg for the
            full per-delivery + gamma + plot + save
            decomposition. Ends in displaying_results
            OR error_pdf_conversion.
        end note
    else (no)
        :no-op (premature click);
        :tier preserved;
    endif
else (no)
    :tier preserved;
endif

if (advanced_mode?) then (yes)
    :advanced_debugging panel rendered;
    note right
        PY:787-788 -- the Compare Baseline button is rendered here
        but only fires its handler if the user clicks it (Phase 2 above).
    end note
endif

|Output|
:state{} after rerun;
note right
    Tier: ready_to_calculate | displaying_results | error_pdf_conversion |
          idle_<role>_method_dispatched(Method) | configuring_mode | etc.
    sidebar.{reference,evaluation}_overview: populated by render_overview_block
    sidebar.{icom,trf}_status_lines: populated iff status_check_button fired
    main.rendered_sections: ordered list of section atoms
    Edge-triggered widgets (status_check, compare_baseline,
    run_calculation): reset to false.
end note
stop

@enduml
